          window.apoApplyAddonDiscount = function (optionValues) {
            var percent = Number(window.ap_front_settings && window.ap_front_settings.addon_discount_percent) || 0;
            if (!(percent > 0) || percent > 100 || !Array.isArray(optionValues)) return;
            var addonTypes = ["useexistingvariant", "chargeorbundle", "createcharge"];
            optionValues.forEach(function (optionValue) {
              if (!optionValue || addonTypes.indexOf(optionValue.type) === -1) return;
              var price = parseFloat(optionValue.price) || 0;
              if (!(price > 0)) return;
              // Re-renders re-read the variant price, so only fall back to the cached base when the
              // price still is the one this hook wrote - otherwise the discount would compound.
              var basePrice = price === optionValue.apo_base_discounted ? optionValue.apo_base_price : price;
              optionValue.apo_base_price = basePrice;
              optionValue.price = Math.round(basePrice * (100 - percent)) / 100;
              optionValue.apo_base_discounted = optionValue.price;
            });
