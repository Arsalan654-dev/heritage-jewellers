(function(){
var isOpen=false;
function buildDrawer(){
  if(document.getElementById('hj-nav-drawer'))return;
  var overlay=document.createElement('div');
  overlay.id='hj-nav-overlay';
  document.body.appendChild(overlay);
  var menuLinks='';
  var mbNav=document.getElementById('menu-mb__ul');
  if(mbNav){
    var items=mbNav.querySelectorAll(':scope > li');
    items.forEach(function(li){
      var a=li.querySelector(':scope > a');
      if(!a)return;
      var href=a.getAttribute('href')||'#';
      var txt=a.textContent.trim();
      var subUl=li.querySelector('.t4s-sub-menu');
      if(subUl){
        var subItems='';
        subUl.querySelectorAll(':scope > li').forEach(function(sli){
          var sa=sli.querySelector('a');
          if(sa)subItems+='<li><a href="'+sa.getAttribute('href')+'">'+sa.textContent.trim()+'</a></li>';
        });
        menuLinks+='<li class="hj-has-sub"><a href="'+href+'">'+txt+' <span class="hj-sub-toggle">&#9662;</span></a><ul class="hj-sub-menu">'+subItems+'</ul></li>';
      }else{
        menuLinks+='<li><a href="'+href+'">'+txt+'</a></li>';
      }
    });
  }
  var catLinks='';
  var mbCat=document.getElementById('shopify-mb_cat');
  if(mbCat){
    mbCat.querySelectorAll('a').forEach(function(a){
      catLinks+='<li><a href="'+a.getAttribute('href')+'">'+a.textContent.trim()+'</a></li>';
    });
  }
  var drawer=document.createElement('div');
  drawer.id='hj-nav-drawer';
  drawer.innerHTML='<div class="hj-drawer-header"><h3>Menu</h3><button class="hj-close-btn" aria-label="Close menu">&times;</button></div><div class="hj-drawer-tabs"><div class="hj-drawer-tab active" data-tab="menu">Menu</div><div class="hj-drawer-tab" data-tab="cat">Categories</div></div><div class="hj-tab-content" data-tab="menu"><ul class="hj-nav-list">'+menuLinks+'</ul></div><div class="hj-tab-content" data-tab="cat" style="display:none"><ul class="hj-nav-list">'+catLinks+'</ul></div>';
  document.body.appendChild(drawer);
  drawer.querySelectorAll('.hj-sub-toggle').forEach(function(tog){
    tog.parentElement.addEventListener('click',function(e){
      e.preventDefault();
      e.stopPropagation();
      var sub=tog.closest('li').querySelector('.hj-sub-menu');
      if(sub)sub.classList.toggle('open');
    });
  });
  drawer.querySelectorAll('.hj-drawer-tab').forEach(function(tab){
    tab.addEventListener('click',function(){
      drawer.querySelectorAll('.hj-drawer-tab').forEach(function(t){t.classList.remove('active');});
      tab.classList.add('active');
      var name=tab.getAttribute('data-tab');
      drawer.querySelectorAll('.hj-tab-content').forEach(function(c){c.style.display='none';});
      var target=drawer.querySelector('.hj-tab-content[data-tab="'+name+'"]');
      if(target)target.style.display='block';
    });
  });
  drawer.querySelector('.hj-close-btn').addEventListener('click',function(e){e.stopPropagation();closeDrawer();});
  overlay.addEventListener('click',closeDrawer);
}
function openDrawer(){
  buildDrawer();
  isOpen=true;
  var d=document.getElementById('hj-nav-drawer');
  var o=document.getElementById('hj-nav-overlay');
  if(d)d.classList.add('open');
  if(o)o.classList.add('active');
  document.body.classList.add('hj-nav-open');
}
function closeDrawer(){
  isOpen=false;
  var d=document.getElementById('hj-nav-drawer');
  var o=document.getElementById('hj-nav-overlay');
  if(d)d.classList.remove('open');
  if(o)o.classList.remove('active');
  document.body.classList.remove('hj-nav-open');
}
document.addEventListener('click',function(e){
  if(e.target.closest('.t4s-push-menu-btn')||e.target.closest('[data-drawer-options]')){
    e.preventDefault();
    e.stopPropagation();
    openDrawer();
    return false;
  }
},true);
document.addEventListener('keydown',function(e){
  if((e.key==='Escape'||e.keyCode===27)&&isOpen)closeDrawer();
});
})();
</script>
