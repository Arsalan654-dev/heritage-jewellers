<script>
(function() {
  function dismissKlaviyoPopup() {
    // Remove Klaviyo overlay containers (be specific - only actual popup elements)
    var popup = document.querySelector('.klaviyo-bis, [class*="klaviyo-form"], [id*="klaviyo"]');
    if (popup) popup.remove();

    // Remove any fixed-position Klaviyo overlay/backdrop
    document.querySelectorAll('div[style]').forEach(function(el) {
      var bg = el.style.backgroundColor || '';
      var z  = parseInt(el.style.zIndex || '0', 10);
      if ((bg.includes('rgba(0, 0, 0') || bg.includes('rgba(0,0,0')) && z > 9000) {
        var hasKlaviyo = (el.innerHTML || '').toLowerCase().includes('klaviyo') || (el.innerHTML || '').toLowerCase().includes('unlock');
        if (hasKlaviyo) el.remove();
      }
    });

    // Restore body scroll
    document.body.classList.remove('klaviyo-prevent-body-scrolling');
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
  }

  // Listen ONLY for clicks on "No, thanks" links (very specific match)
  document.addEventListener('click', function(e) {
    var text = (e.target.textContent || '').trim().toLowerCase();
    if (text === 'no, thanks' || text === 'no thanks') {
      e.preventDefault();
      e.stopPropagation();
      dismissKlaviyoPopup();
    }
  }, true);

  // Periodic cleanup for the overlay (timed after Klaviyo renders)
  setTimeout(dismissKlaviyoPopup, 1500);

  window.closeKlaviyoPopup = dismissKlaviyoPopup;
})();
</script>
